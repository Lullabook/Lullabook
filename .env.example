# Lullabook environment — copy to .env.local and fill in real values.
# Never commit real secrets. Every variable is read lazily (adapters/env.ts),
# so tests and builds run without any of these set.

# --- Supabase (Postgres + Auth + RLS) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, used by the SupabaseDataStore unit of work.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (story generation, claude-sonnet-4-6) ------------------------
ANTHROPIC_API_KEY=

# --- fal.ai (LoRA training + image inference) -------------------------------
FAL_API_KEY=
# Public URL fal calls when a training job finishes (the fal webhook route):
#   https://<your-domain>/api/webhooks/fal
FAL_WEBHOOK_URL=

# --- Moderation -------------------------------------------------------------
# Sightengine image/text classifiers.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Optional dedicated CSAM hash-match service (e.g. PhotoDNA-compatible).
# When unset, the CSAM layer fails closed only on classifier escalation.
CSAM_HASH_API_URL=
CSAM_HASH_API_KEY=

# --- Blob store (Cloudflare R2 or S3) ---------------------------------------
# For R2 set BLOB_S3_ENDPOINT to the account endpoint; for plain S3 leave it
# empty and set the region.
BLOB_S3_ENDPOINT=
BLOB_S3_REGION=auto
BLOB_S3_BUCKET=lullabook
BLOB_S3_ACCESS_KEY_ID=
BLOB_S3_SECRET_ACCESS_KEY=

# --- Stripe (subscription + payment-VPC) ------------------------------------
STRIPE_SECRET_KEY=
# The recurring price for the subscription plan.
STRIPE_PRICE_ID=
# From `stripe listen` locally or the dashboard webhook config:
#   endpoint https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- RevenueCat (iOS IAP webhook) -------------------------------------------
# Authorization header value RevenueCat sends: `Bearer <secret>`
REVENUECAT_WEBHOOK_SECRET=

# --- Inngest (durable workflows) --------------------------------------------
# Unset locally (the dev server needs neither); required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Notifications -----------------------------------------------------------
# Resend for email.
RESEND_API_KEY=
EMAIL_FROM=Lullabook <stories@yourdomain.com>
# Web push (generate once: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# --- AWS Rekognition (adult Persona selfie match) ----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REKOGNITION_REGION=us-east-1

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set "true" only after the ADR-0005 multi-persona composition spike passes.
MULTI_PERSONA_REF_MODEL=false
# Sentry (free Developer plan, EU/Frankfurt region). Disabled when unset or under test.
SENTRY_DSN=
