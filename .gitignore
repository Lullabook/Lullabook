# Secrets — never commit
.env
.env.*
*.pem
*.key

# Local dev blob store (issue 57)
.localblob/

# Node / Next.js
node_modules/
.next/
.next-free/
.next-paid/
test-results/
playwright-report/
out/
dist/
build/
coverage/

# Kaizen coach generated brief (regenerate via tools/kaizen-coach/coach.sh)
KAIZEN-REVIEW-BRIEF.md

# OS / editor
.DS_Store
*.log
.vscode/
.idea/

# Obsidian — the vault is CONTEXT/. Per-machine UI state only; shared config
# (appearance, plugins) stays committed.
.obsidian/
CONTEXT/.obsidian/workspace.json
CONTEXT/.obsidian/workspace-mobile.json
CONTEXT/.obsidian/graph.json
tsconfig.tsbuildinfo

# macOS Finder/iCloud duplicate cruft ("Name 2.ext" / "Name 2") — these once broke
# expo-router (duplicate route files → every screen "Unmatched Route"). Never commit.
* 2.*
* 2
* [0-9].*

# Generated audit / debug artifacts (not source)
appaudit-report-*.md
COMPOSER_*_DEBUG_PROMPT.md
