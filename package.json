{
  "name": "lullabook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:free": "DEV_FORCE_SUBSCRIPTION=inactive NEXT_DEV_DIST_DIR=.next-free next dev -p 3000",
    "dev:paid": "DEV_FORCE_SUBSCRIPTION=active DEV_DEMO_SEED=true DEV_FAL_FALLBACK=true DEV_LIVENESS_BYPASS=true NEXT_DEV_DIST_DIR=.next-paid next dev -p 3001",
    "dev:all": "DEV_FORCE_SUBSCRIPTION=active DEV_DEMO_SEED=true DEV_FAL_FALLBACK=true DEV_LIVENESS_BYPASS=true R1_AUDIO_ENABLED=true R1_MULTI_FAMILY_ENABLED=true R1_JOURNAL_MACHINERY_ENABLED=true NEXT_DEV_DIST_DIR=.next-all next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx tools/print-db-migrate.ts",
    "check:runbook": "node scripts/check-hitl-runbook.mjs",
    "smoke:provider-bakeoff": "tsx tools/provider-bakeoff.ts",
    "smoke:r1-provider-e2e": "tsx tools/r1-provider-e2e.ts",
    "verify": "node scripts/verify.mjs",
    "graph:index": "node scripts/build-graph-index.mjs",
    "super:run": "node scripts/super-engineering-launcher.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-rekognition": "^3.1066.0",
