# Optional: mobile/.env overrides. By default app.config.ts also reads ../.env.local
# and maps NEXT_PUBLIC_SUPABASE_* to EXPO_PUBLIC_* automatically.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# Simulator-only dev sign-in (__DEV__ builds). Email auth uses Supabase email provider,
# not Google OAuth — works when Google/Apple are disabled in the Supabase dashboard.
EXPO_PUBLIC_DEV_EMAIL=simulator@lullabook.dev
EXPO_PUBLIC_DEV_PASSWORD=SimulatorDev1!

# ADR-0026 / PRD v19: un-cut the Learning story type + Journal (solo, one Baby).
# Set to "true" to enable; unset = cut (R1 default, reversible).
EXPO_PUBLIC_R1_STORY_TYPES_ENABLED=true
EXPO_PUBLIC_R1_JOURNAL_MACHINERY_ENABLED=true

# Issue 206 — free Apple ID personal team device builds.
# Set to exactly "1" to strip free-team-blocked entitlements (Sign in with
# Apple, associated domains). It must NEVER be set for a production or
# TestFlight build; unset is the production configuration.
# LULLABOOK_FREE_TEAM=1
